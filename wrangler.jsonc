// Cloudflare Workers (static assets only, no server code).
// The Worker name must match the project name in the Cloudflare dashboard.
{
  "$schema": "https://unpkg.com/wrangler@4/config-schema.json",
  "name": "apps-building",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    // Any unknown path serves index.html so client-side routes work offline-first.
    "not_found_handling": "single-page-application",
  },
}
